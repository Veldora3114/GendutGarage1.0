# ==========================================================
# Dockerfile Cepat (Menggunakan hasil build lokal: build/web)
# Jalankan `flutter build web --release` terlebih dahulu di lokal.
# ==========================================================
FROM nginx:alpine

# Pasang konfigurasi Nginx SPA
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Salin aset web lokal langsung ke Nginx
COPY build/web /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
